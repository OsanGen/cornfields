{
  "name": "cornfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, local-first cornfield horror prototype.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview-dist.mjs",
    "test:build": "node --test tests/build.test.mjs",
    "test:upgrade": "node tests/upgrade-browser.mjs",
    "test:player": "node --test tests/player-upgrade.test.mjs",
    "test:player:browser": "node tests/player-upgrade-browser.mjs",
    "test:effects:browser": "node tests/shot-beacon-browser.mjs",
    "test:polish:browser": "node tests/polish-browser.mjs",
    "build:renderer-trial": "node scripts/build-renderer-trial.mjs",
    "test:renderer-trial": "node tests/renderer-trial-browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:runtime": "node --test tests/input.test.mjs tests/touch-input.test.mjs tests/ui-runtime.test.mjs",
    "test:gameplay": "node --test tests/game.test.mjs tests/survival.test.mjs tests/gameplay-regressions.test.mjs",
    "test:browser": "node tests/hands-corn-browser.mjs",
    "test:intro": "node --test tests/intro.test.mjs tests/intro-audio.test.mjs",
    "test:intro:browser": "node tests/intro-browser.mjs",
    "test:prologue": "node --test --test-concurrency=1 tests/opening.test.mjs tests/interactive-prologue.test.mjs tests/prologue*.test.mjs",
    "test:prologue:browser": "node tests/prologue-browser.mjs",
    "test:mobile": "CORNFIELD_DEVICE=phone node tests/hands-corn-browser.mjs",
    "build:site": "node scripts/build-visual-check-site.mjs cornfields",
    "test:visual-check": "node --test tests/visual-check-backend.test.mjs tests/visual-check-zip.test.mjs tests/visual-check-suspend.test.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
